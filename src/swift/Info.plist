<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Appens namn och grundinställningar -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>StreamPlayer</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- ================================================================= -->
    <!-- KRITISKT FÖR LIVESTREAM: App Transport Security (ATS)            -->
    <!-- Tillåter externa videoströmmar, HLS .m3u8-segment och PHP-spelare -->
    <!-- ================================================================= -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Tillåter osäkra HTTP-anrop i WebKit-spelaren (många IPTV-segment använder HTTP) -->
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
        <!-- Valfritt: Tillåt även för native AVPlayer/URLSession om streamen inte är HTTPS -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- ================================================================= -->
    <!-- BAKGRUNDSLJUD & PICTURE IN PICTURE                               -->
    <!-- ================================================================= -->
    <key>UIBackgroundModes</key>
    <array>
        <!-- Tillåter att ljudet fortsätter spelas när skärmen släcks eller appen minimeras -->
        <string>audio</string>
    </array>

    <!-- Skärmorienteringar för iPhone & iPad (Viktigt för helskärmsspelaren) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Hantering av statusfält vid helskärm -->
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
</dict>
</plist>
